# ==============================================================================
# Environment Variables Configuration
# ==============================================================================

# Resend API Key for dispatching corporate lead form emails from /kirim.php
# Get your API key from https://resend.com
RESEND_API_KEY=re_your_api_key_here

# (Optional) Destination inbox where lead notification emails will be delivered.
# Defaults to info@wahanatotalita.com if not specified.
RESEND_TO_EMAIL=info@wahanatotalita.com

# (Optional) Sender email address.
# Defaults to 'Wahana Training Portal <onboarding@resend.dev>' or use your verified domain address.
# e.g., 'Wahana Totalita <notifikasi@wahanatotalita.com>'
RESEND_FROM_EMAIL=Wahana Training Portal <onboarding@resend.dev>
